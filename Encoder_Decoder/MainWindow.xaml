<Window x:Class="Encoder_Decoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Encoder_Decoder"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <StackPanel Margin="78,30,78,29">

            <TextBox x:Name="InputTextBox" 
                     ToolTip="Введите текст"
                     Margin="5"/>

            <TextBox x:Name="MatrixBox" 
                     ToolTip="Введите матрицу (например: 3 3; 2 5)"
                     Margin="5"/>

            <Button Content="Зашифровать" Click="Encrypt_Click" Margin="5"/>
            <Button Content="Расшифровать" Click="Decrypt_Click" Margin="5"/>

            <TextBox x:Name="ResultTextBox" Margin="5"/>

        </StackPanel>
    </Grid>
</Window>
